                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', function () {",
                  "  pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Errores de email y password', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.errors.email).to.exist;",
                  "  pm.expect(json.errors.password).to.exist;",
                  "});"
                ]
              }
