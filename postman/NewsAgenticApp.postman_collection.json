    {
      "name": "02 News",
      "item": [
        {
          "name": "Listar noticias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve al menos 5 noticias', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.at.least(5);",
                  "});",
                  "pm.test('Primera noticia tiene estructura de card', function () {",
                  "  const item = pm.response.json().data[0];",
                  "  pm.expect(item).to.include.keys(['id', 'title', 'image_url', 'excerpt', 'published_at', 'category']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
