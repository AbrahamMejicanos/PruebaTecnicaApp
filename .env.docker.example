POSTGRES_DB=news_agentic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

BACKEND_PORT=8000
APP_NAME=NewsAgenticApp
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Opcional pero recomendado en servidor para que las claves sobrevivan recreaciones:
# APP_KEY=base64:$(openssl rand -base64 32)
# JWT_SECRET=$(openssl rand -hex 32)
APP_KEY=
JWT_SECRET=
JWT_TTL=60

SUPERUSER_NAME="Tu Nombre"
SUPERUSER_EMAIL="tu-correo@example.com"
SUPERUSER_PASSWORD="tu-password-seguro"

RUN_MIGRATIONS=true
RUN_SEEDERS=true
